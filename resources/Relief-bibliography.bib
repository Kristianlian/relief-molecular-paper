@article{karlsen_preserved_2020,
	title = {Preserved capacity for satellite cell proliferation, regeneration, and hypertrophy in the skeletal muscle of healthy elderly men},
	volume = {34},
	issn = {0892-6638, 1530-6860},
	url = {https://faseb.onlinelibrary.wiley.com/doi/10.1096/fj.202000196R},
	doi = {10.1096/fj.202000196R},
	abstract = {Abstract
            
              Blunted muscle hypertrophy and impaired regeneration with aging have been partly attributed to satellite cell (SC) dysfunction. However, true muscle regeneration has not yet been studied in elderly individuals. To investigate this, muscle injury was induced by 200 electrically stimulated (ES) eccentric contractions of the vastus lateralis (VL) of one leg in seven young (20‐31 years) and 19 elderly men (60‐73 years). This was followed by 13 weeks of resistance training (RT) for both legs to investigate the capacity for hypertrophy. Muscle biopsies were collected Pre‐ and Post‐RT, and 9 days after ES, for immunohistochemistry and RT‐PCR. Hypertrophy was assessed by MRI, DEXA, and immunohistochemistry. Overall, surprisingly comparable responses were observed between the young and elderly. Nine days after ES, Pax7+ SC number had doubled (
              P
               {\textless} .05), alongside necrosis and substantial changes in expression of genes related to matrix, myogenesis, and innervation (
              P
               {\textless} .05). Post‐RT, VL cross‐sectional area had increased in both legs ({\textasciitilde}15\%,
              P
               {\textless} .05) and SCs/type II fiber had increased {\textasciitilde}2‐4 times more with ES+RT vs RT alone (
              P
               {\textless} .001). Together these novel findings demonstrate “youthful” regeneration and hypertrophy responses in human elderly muscle. Furthermore, boosting SC availability in healthy elderly men does not enhance the subsequent muscle hypertrophy response to RT.},
	language = {en},
	number = {5},
	urldate = {2026-08-10},
	journal = {The FASEB Journal},
	author = {Karlsen, Anders and Soendenbroe, Casper and Malmgaard‐Clausen, Nikolaj M. and Wagener, Frederik and Moeller, Casper Emil and Senhaji, Zouhir and Damberg, Kristine and Andersen, Jesper Løvind and Schjerling, Peter and Kjaer, Michael and Mackey, Abigail L.},
	month = may,
	year = {2020},
	pages = {6418--6436},
}

